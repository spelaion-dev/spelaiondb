{
  "name": "spelaion-desktop",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-i18n.mjs && node --test scripts/explorer-sort.test.mjs scripts/connection-marks.test.mjs scripts/fuzzy.test.mjs scripts/connection-search.test.mjs scripts/db-search.test.mjs scripts/commands.test.mjs scripts/editor-actions.test.mjs scripts/sql-completion.test.mjs scripts/ico.test.mjs scripts/dialog-paths.test.mjs scripts/er-text.test.mjs scripts/menu-placement.test.mjs && tsc --noEmit && vite build",
    "bindings": "cargo run -q -p spelaion-desktop --features bindings --bin export-bindings",
    "icons": "node scripts/icons.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "apache-arrow": "^21.2.0",
    "codemirror": "^6.0.2",
    "i18next": "^26.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "sql-formatter": "^15.9.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@dbml/core": "^12.0.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "mermaid": "^12.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
