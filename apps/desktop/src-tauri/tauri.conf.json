{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpelaionDB",
  "version": "0.9.0",
  "identifier": "dev.spelaion.db",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "SpelaionDB",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SpelaionDB contributors",
    "copyright": "Copyright 2026 SpelaionDB contributors. Licensed under Apache-2.0.",
    "category": "DeveloperTool",
    "shortDescription": "Desktop database client with first-class SSH tunnels and an MCP server",
    "longDescription": "SpelaionDB is an open-source desktop client for PostgreSQL, MySQL, MariaDB, SQL Server, SQLite and DuckDB, with SSH tunnels through any number of bastions, a read-only MCP server for AI agents, and configuration you can share through git.",
    "homepage": "https://spelaion.dev",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEQ0YxNDY5ODlDMjI3ODEKUldTQko4S0phUlRQemFlODFWU0h1TVlKa3V6TDQ1U04vano3ako1bDFhczM5N2ZmZWladVlia1cK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
